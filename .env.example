# 서버에서 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)
#   cp .env.example .env && nano .env

# 내 도메인 (예: lotto-lab.example.com). 이 도메인이 서버 IP를 가리켜야 HTTPS가 자동으로 켜집니다.
DOMAIN=

# 관리자 계정 (회차 입력, 회원 관리에 쓰는 계정)
LOTTO_ADMIN_USERNAME=admin
LOTTO_ADMIN_PASSWORD=

# 광고(AdSense)를 쓰지 않으면 비워 두세요
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_INLINE=
VITE_ADSENSE_SLOT_BOTTOM=
